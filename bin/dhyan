#!/data/data/com.termux/files/usr/bin/bash
# dhyan — hands-free voice + camera assistant.
# Listens with Android speech recognition, takes a photo for each question,
# asks Claude Code (your Claude subscription), and speaks the answer.
# Say "stop" or "goodbye" to end.
#   dhyan              camera on (rear)
#   dhyan --no-camera  voice only
#   dhyan --front      use the front camera
cd "$HOME/brain" || { echo "~/brain not found — run install.sh first"; exit 1; }
CAM=0; USE_CAM=1
for a in "$@"; do
  case "$a" in
    --no-camera) USE_CAM=0 ;;
    --front) CAM=1 ;;
  esac
done
mkdir -p inbox
first=1
termux-tts-speak "Dhyan is listening."
while true; do
  termux-vibrate -d 60 >/dev/null 2>&1
  q=$(termux-speech-to-text 2>/dev/null | tr -d '\r' | tail -n 1)
  [ -z "$q" ] && continue
  echo "you: $q"
  case "${q,,}" in
    stop|goodbye|"stop listening"|exit|bye) termux-tts-speak "Bye."; break ;;
  esac
  prompt="Spoken question from the user (answer in 1-3 short spoken sentences, no markdown): $q"
  if [ $USE_CAM = 1 ]; then
    img="$PWD/inbox/$(date +%s).jpg"
    termux-camera-photo -c $CAM "$img" >/dev/null 2>&1
    [ -s "$img" ] && prompt="$prompt
A photo from the phone camera taken just now is at /root${img#$HOME} — read it if the question is about what the user is looking at."
  fi
  if [ $first = 1 ]; then cont=""; first=0; else cont="--continue"; fi
  a=$(BRAIN_NO_FILE=1 claude -p $cont --allowedTools "Read" "WebSearch" "WebFetch" -- "$prompt" 2>/dev/null)
  [ -z "$a" ] && a="Sorry, I couldn't get an answer."
  echo "dhyan: $a"
  termux-tts-speak "$a"
  ls -1t inbox/*.jpg 2>/dev/null | tail -n +21 | xargs -r rm -f   # keep last 20 photos
done
nohup "$HOME/bin/brain-file" >/dev/null 2>&1 &
