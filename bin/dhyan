#!/data/data/com.termux/files/usr/bin/bash
# dhyan — hands-free voice + camera assistant.
# Listens with Android speech recognition, takes a photo for each question,
# asks Claude (your Claude subscription, via Claude Code), and speaks the answer.
# Say "stop" or "goodbye" to end.
#   dhyan                 camera on (rear)
#   dhyan --no-camera     voice only
#   dhyan --front         front camera
#   DHYAN_MODEL=opus dhyan   pick the model (default: sonnet — fastest good answers)
#
# Speed: Claude Code is started ONCE per session in streaming mode and kept running,
# so each question costs only the model's answer time (no ~10 s start-up per question).
# Photos are sent inside the message, not opened with a tool. It runs from a small
# folder (~/.dhyan-voice) because start-up inside the bigger ~/brain is much slower;
# brain-file still files these conversations into ~/brain afterwards.
V="$HOME/.dhyan-voice"
MODEL="${DHYAN_MODEL:-sonnet}"
mkdir -p "$V/inbox"
[ -f "$V/CLAUDE.md" ] || cat > "$V/CLAUDE.md" <<'EOF'
# Dhyan voice mode
You are answering spoken questions on the user's Android phone. Answers are read aloud
through earphones: 1-3 short sentences, plain text, no markdown or lists.
A photo from the phone camera may be attached to each question; use it when the
question is about what the user is looking at. Say so if the photo is dark or blurry.
The user's notes live in /root/brain (index.md lists topics) if they ask about them.
EOF
cd "$V" || exit 1
CAM=0; USE_CAM=1
for a in "$@"; do
  case "$a" in
    --no-camera) USE_CAM=0 ;;
    --front) CAM=1 ;;
  esac
done

say() { termux-tts-speak "$1" >/dev/null 2>&1; }
ms()  { echo $(( $(date +%s%N) / 1000000 )); }

# --- start Claude once, keep it running ---
coproc CL { "$HOME/bin/claude-raw" -p --input-format stream-json --output-format stream-json \
              --verbose --model "$MODEL" --allowedTools "Read" "WebSearch" "WebFetch" 2>/dev/null; }
CL_IN=${CL[1]}; CL_OUT=${CL[0]}; CL_PID=$CL_PID
cleanup() { exec {CL_IN}>&- 2>/dev/null; kill "$CL_PID" 2>/dev/null; }
trap cleanup EXIT

ask() {   # $1 = text, $2 = optional jpeg path → prints Claude's answer
  if [ -n "${2:-}" ] && [ -s "$2" ]; then
    base64 -w0 "$2" > "$V/.img.b64"
    jq -cn --arg t "$1" --rawfile img "$V/.img.b64" \
      '{type:"user",message:{role:"user",content:[{type:"image",source:{type:"base64",media_type:"image/jpeg",data:$img}},{type:"text",text:$t}]}}' \
      >&"$CL_IN" || return 1
    rm -f "$V/.img.b64"
  else
    jq -cn --arg t "$1" '{type:"user",message:{role:"user",content:[{type:"text",text:$t}]}}' >&"$CL_IN" || return 1
  fi
  local line
  while IFS= read -r -t 180 line <&"$CL_OUT"; do
    if [ "$(jq -r '.type // empty' <<<"$line" 2>/dev/null)" = result ]; then
      jq -r '.result // empty' <<<"$line"; return 0
    fi
  done
  return 1
}

# Typed test without voice: DHYAN_ASK="what do you see?" dhyan
if [ -n "${DHYAN_ASK:-}" ]; then
  img=""; [ $USE_CAM = 1 ] && { img="$V/inbox/test.jpg"; termux-camera-photo -c $CAM "$img" >/dev/null 2>&1; }
  for i in 1 2; do
    t0=$(ms); a=$(ask "$DHYAN_ASK" "$img"); t1=$(ms)
    echo "answer $i ($(( (t1-t0)/1000 ))s): $a"
    img=""
  done
  exit 0
fi

say "Dhyan is listening."
while true; do
  kill -0 "$CL_PID" 2>/dev/null || { echo "Claude stopped unexpectedly."; say "Claude stopped. Please restart Dhyan."; break; }
  termux-vibrate -d 60 >/dev/null 2>&1
  echo "(listening…)"
  q=$(termux-speech-to-text 2>/dev/null | tr -d '\r' | tail -n 1)
  [ -z "$q" ] && continue
  echo "you: $q"
  case "${q,,}" in
    stop|goodbye|"stop listening"|exit|bye) say "Bye."; break ;;
  esac
  t0=$(ms)
  say "One moment." & ack=$!
  img=""
  if [ $USE_CAM = 1 ]; then
    img="$V/inbox/$(date +%s).jpg"
    termux-camera-photo -c $CAM "$img" >/dev/null 2>&1
  fi
  t1=$(ms)
  echo "(thinking…)"
  a=$(ask "Spoken question: $q" "$img")
  [ -z "$a" ] && a="Sorry, I couldn't get an answer."
  t2=$(ms)
  echo "dhyan: $a"
  echo "   [photo $(( (t1-t0)/1000 ))s · answer $(( (t2-t1)/1000 ))s]"
  wait "$ack" 2>/dev/null   # let "One moment" finish (don't wait on the Claude process)
  say "$a"
  ls -1t "$V"/inbox/*.jpg 2>/dev/null | tail -n +21 | xargs -r rm -f   # keep last 20 photos
done
cleanup
nohup "$HOME/bin/brain-file" >/dev/null 2>&1 &
